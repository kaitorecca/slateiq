<?xml version="1.0"?>
<!-- SlateIQ users/profiles. Passwords come from the container env (see .env on the VM).
     - default   : admin/ingest user, used by seed_remote.sh and the Grafana /ch/ proxy fallback.
     - agent_ro  : the ONLY user mcp-clickhouse (and therefore the ADK agent) ever connects with.
                   readonly=2 -> SELECT + SET settings, no INSERT/ALTER/DDL. -->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>419430400</max_memory_usage>          <!-- 400 MiB -->
            <max_bytes_before_external_group_by>209715200</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>209715200</max_bytes_before_external_sort>
            <max_threads>2</max_threads>
            <max_block_size>16384</max_block_size>
            <max_insert_block_size>131072</max_insert_block_size>
            <join_algorithm>grace_hash,partial_merge,hash</join_algorithm>
            <log_queries>1</log_queries>
        </default>

        <agent_ro>
            <max_memory_usage>419430400</max_memory_usage>          <!-- 400 MiB -->
            <max_bytes_before_external_group_by>209715200</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>209715200</max_bytes_before_external_sort>
            <max_threads>2</max_threads>
            <max_block_size>16384</max_block_size>
            <max_execution_time>30</max_execution_time>
            <max_result_rows>20000</max_result_rows>
            <max_result_bytes>16777216</max_result_bytes>
            <result_overflow_mode>break</result_overflow_mode>
            <readonly>2</readonly>
            <allow_ddl>0</allow_ddl>
            <log_queries>1</log_queries>
        </agent_ro>
    </profiles>

    <users>
        <default>
            <password from_env="CH_DEFAULT_PASSWORD" replace="replace"/>
            <profile>default</profile>
            <quota>default</quota>
            <networks><ip>::/0</ip></networks>
            <access_management>1</access_management>
        </default>

        <agent_ro>
            <password from_env="CH_AGENT_RO_PASSWORD"/>
            <profile>agent_ro</profile>
            <quota>agent_ro</quota>
            <networks><ip>::/0</ip></networks>
            <allow_databases>
                <database>slateiq</database>
                <database>system</database>
                <database>default</database>
                <database>information_schema</database>
                <database>INFORMATION_SCHEMA</database>
            </allow_databases>
        </agent_ro>
    </users>

    <quotas>
        <agent_ro>
            <interval>
                <duration>60</duration>
                <queries>240</queries>
                <errors>60</errors>
                <execution_time>240</execution_time>
            </interval>
        </agent_ro>
    </quotas>
</clickhouse>
