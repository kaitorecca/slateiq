# SlateIQ — copy to .env and fill in.  `.env` is gitignored; never commit real keys.
#   cp .env.example .env && ${EDITOR:-vi} .env

# --- Gemini ---------------------------------------------------------------
# One key from https://aistudio.google.com/apikey — both names are read
# (google-genai reads GOOGLE_API_KEY, the ingest pipeline reads GEMINI_API_KEY).
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# --- ClickHouse -----------------------------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_SECURE=false

# --- MCP ------------------------------------------------------------------
# Where the agent looks for the ClickHouse MCP server, and where
# scripts/mcp_up.sh binds it.  Keep the two ports in step.
CLICKHOUSE_MCP_URL=http://localhost:8765/mcp
CLICKHOUSE_MCP_BIND_PORT=8765

# --- optional -------------------------------------------------------------
# ffmpeg/ffprobe if they are not on PATH (ingest only)
# FFMPEG_BIN=/usr/bin/ffmpeg
# FFPROBE_BIN=/usr/bin/ffprobe
# Serve clips/thumbs from a public bucket instead of local paths
# SLATEIQ_MEDIA_BASE_URL=https://storage.googleapis.com/your-bucket

# --- Vertex AI (deployment only; leave unset for local API-key use) --------
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
